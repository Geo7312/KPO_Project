<Window x:Class="RepairDesk.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RepairDesk — учёт ремонта компьютерной техники" Width="1180" Height="780" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#F4F7FB">
  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Background="#17324F" CornerRadius="8" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="RepairDesk" FontSize="22" FontWeight="Bold" Foreground="White"/><TextBlock Text="Учёт заказов на ремонт компьютерной техники" Foreground="#DDE8F2"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Рабочая роль:" Foreground="White" VerticalAlignment="Center"/><ComboBox Width="160" ItemsSource="{Binding Roles}" SelectedItem="{Binding CurrentRole}" DisplayMemberPath="Title"/><Button Content="Обновить" Command="{Binding RefreshCommand}"/></StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#DFEAF3" CornerRadius="5" Padding="8" Margin="0,10,0,0"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/></Border>
    <TabControl Background="White">
      <TabItem Header="Новый заказ">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="700" HorizontalAlignment="Left">
          <TextBlock Text="Оформление заказа" FontSize="19" FontWeight="Bold"/>
          <TextBlock Text="Создаёт приёмщик или администратор. Клиент, тип устройства и неисправность обязательны." TextWrapping="Wrap" Foreground="#526273"/>
          <TextBlock Text="ФИО клиента"/><TextBox Text="{Binding CustomerInput, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Телефон"/><TextBox Text="{Binding PhoneInput, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Тип устройства"/><TextBox Text="{Binding DeviceTypeInput, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Модель"/><TextBox Text="{Binding DeviceModelInput, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Серийный номер"/><TextBox Text="{Binding SerialInput, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Неисправность со слов клиента"/><TextBox Text="{Binding ProblemInput, UpdateSourceTrigger=PropertyChanged}" Height="65" TextWrapping="Wrap" AcceptsReturn="True"/>
          <Button Content="Создать заказ" Command="{Binding CreateOrderCommand}" HorizontalAlignment="Left" Margin="3,12,3,3" Background="#DDEAF7"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Заказы">
        <Grid Margin="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <DataGrid Grid.Column="0" ItemsSource="{Binding OrderItems}" SelectedItem="{Binding SelectedOrder}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns><DataGridTextColumn Header="№" Binding="{Binding Number}" Width="80"/><DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="135"/></DataGrid.Columns>
          </DataGrid>
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,0,8,12">
            <TextBlock Text="Карточка заказа" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedOrder.Number, StringFormat=Номер: {0}}"/>
            <TextBlock Text="{Binding SelectedOrder.CustomerName, StringFormat=Клиент: {0}}"/>
            <TextBlock Text="{Binding SelectedOrder.DeviceName, StringFormat=Устройство: {0}}"/>
            <TextBlock Text="{Binding SelectedOrder.Problem, StringFormat=Неисправность: {0}}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedOrder.StatusName, StringFormat=Статус: {0}}" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedOrder.Total, StringFormat=Сумма: {0:N2} ₽}" FontWeight="Bold"/>
            <Separator Margin="0,8"/>
            <TextBlock Text="Диагностика" FontWeight="Bold"/><TextBox Text="{Binding DiagnosisInput, UpdateSourceTrigger=PropertyChanged}" Height="55" TextWrapping="Wrap" AcceptsReturn="True"/>
            <TextBlock Text="План работ" FontWeight="Bold"/><TextBox Text="{Binding WorkPlanInput, UpdateSourceTrigger=PropertyChanged}" Height="55" TextWrapping="Wrap" AcceptsReturn="True"/>
            <Button Content="Сохранить диагностику" Command="{Binding SaveDiagnosisCommand}" HorizontalAlignment="Left"/>
            <TextBlock Text="Решение клиента: приёмщик выбирает заказ со статусом «Ожидает согласования», затем фиксирует согласие или отказ." TextWrapping="Wrap" Margin="3,8,3,3"/>
            <WrapPanel><Button Content="Клиент согласен" Command="{Binding ApproveCommand}" IsEnabled="{Binding CanRecordDecision}"/><Button Content="Клиент отказался" Command="{Binding DeclineCommand}" IsEnabled="{Binding CanRecordDecision}"/></WrapPanel>
            <Separator Margin="0,8"/>
            <TextBlock Text="Выполненная работа" FontWeight="Bold"/><TextBox Text="{Binding WorkDescriptionInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Описание работы"/><TextBox Text="{Binding WorkPriceInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Цена"/><Button Content="Добавить работу" Command="{Binding AddWorkCommand}" HorizontalAlignment="Left"/>
            <DataGrid ItemsSource="{Binding SelectedOrder.Works}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="95" Margin="3"><DataGrid.Columns><DataGridTextColumn Header="Работа" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="90"/></DataGrid.Columns></DataGrid>
            <TextBlock Text="Списать выбранную запчасть из вкладки «Запчасти»" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><TextBox Width="70" Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Количество"/><Button Content="Списать деталь" Command="{Binding UsePartCommand}"/></StackPanel>
            <DataGrid ItemsSource="{Binding SelectedOrder.Parts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="95" Margin="3"><DataGrid.Columns><DataGridTextColumn Header="Деталь" Binding="{Binding PartName}" Width="*"/><DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="65"/><DataGridTextColumn Header="Сумма" Binding="{Binding Sum, StringFormat={}{0:N2}}" Width="90"/></DataGrid.Columns></DataGrid>
            <WrapPanel Margin="0,8,0,0"><Button Content="Готово к выдаче" Command="{Binding ReadyCommand}"/><Button Content="Выдать" Command="{Binding IssueCommand}"/><Button Content="Печать акта" Command="{Binding PrintCommand}"/></WrapPanel>
          </StackPanel></ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Запчасти">
        <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Каталог запчастей" FontSize="19" FontWeight="Bold"/><TextBlock Text="Добавление доступно администратору. Выберите деталь ниже, затем спишите её в карточке заказа." TextWrapping="Wrap"/>
            <WrapPanel><TextBox Width="240" Text="{Binding PartNameInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Наименование"/><TextBox Width="150" Text="{Binding PartArticleInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Артикул"/><TextBox Width="90" Text="{Binding PartStockInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Остаток"/><TextBox Width="100" Text="{Binding PartPriceInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Цена"/><Button Content="Добавить деталь" Command="{Binding AddPartCommand}"/></WrapPanel>
          </StackPanel>
          <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding PartItems}" SelectedItem="{Binding SelectedPart}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="170"/><DataGridTextColumn Header="Остаток" Binding="{Binding Stock}" Width="100"/><DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="110"/></DataGrid.Columns></DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="Сводка"><StackPanel Margin="20"><TextBlock Text="Сводка по заказам" FontSize="19" FontWeight="Bold"/><TextBlock Text="{Binding SummaryText}" FontSize="17" LineHeight="34"/></StackPanel></TabItem>
    </TabControl>
  </DockPanel>
</Window>
